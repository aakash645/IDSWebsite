# Backend Server Configuration
BACKEND_PORT=5000

# Email Configuration (use Gmail or your email service)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
